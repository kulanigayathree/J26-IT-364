# Copy to .env.local and adjust.

# Base URL of the FastAPI service in integration/api (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# true  = try the API first, fall back to each feature's mock/ data if the API is unreachable.
# false = API only (use for demos against the real API). Defaults to true in `npm run dev`.
VITE_USE_MOCKS=true
